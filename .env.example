# ---------------- Langflow on your laptop ----------------
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=replace-with-your-langflow-api-key
LANGFLOW_FLOW_ID=replace-with-your-flow-id

# ---------------- Guardian model endpoint ----------------
# Set this to the OpenAI-compatible base URL where your model is served.
# Example: http://your-model-host:8000/v1
GUARDIAN_MODEL_BASE_URL=http://your-model-host:8000/v1
GUARDIAN_MODEL_CHAT_PATH=/chat/completions
GUARDIAN_MODEL_NAME=guardian-qwen3-8b-sft-v2

GUARDIAN_MODEL_JSON_MODE=false
GUARDIAN_MODEL_TIMEOUT_SECONDS=600
GUARDIAN_MODEL_MAX_TOKENS=2500
GUARDIAN_MODEL_TEMPERATURE=0.2

# ---------------- Local runner ----------------
GUARDIAN_CONFIG=config/guardian.yaml
GUARDIAN_OUTPUT_ROOT=runs

# Execution is deliberately off by default because Langflow tools may write to a DB,
# send notifications, or call other services. Set true only for your test environment.
GUARDIAN_ALLOW_SIDE_EFFECTS=false

# Optional database inspection. Leave blank to use only snapshot files.
GUARDIAN_DB_URL=
